{
  "name": "xiaoya-chinese-tutor",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,web -c magenta,cyan \"node server/index.mjs\" \"vite\"",
    "build": "tsc --noEmit && vite build",
    "start": "NODE_ENV=production node server/index.mjs",
    "voice": "cd ../AI-Chinese-Teacher && ./.venv-tts/bin/python tts_service.py",
    "voice:vi": "cd ../AI-Chinese-Teacher && ./.venv-vitts/bin/python vitts_service.py",
    "typecheck": "tsc --noEmit",
    "test": "node --test server/*.test.mjs src/lib/*.test.ts",
    "eval:corrections": "node eval/corrections.mjs",
    "eval:tones": "node eval/tones.mjs",
    "setup:whisper": "bash scripts/setup-whisper.sh",
    "format": "node scripts/format.mjs",
    "format:check": "node scripts/format.mjs --check",
    "check:assets": "node scripts/check-public-assets.mjs"
  },
  "dependencies": {
    "@met4citizen/talkinghead": "^1.7.0",
    "@myned-ai/gsplat-flame-avatar-renderer": "^1.4.0",
    "express": "^5.3.0",
    "jszip": "^3.10.2",
    "msedge-tts": "^2.1.0",
    "pinyin-pro": "^3.29.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
