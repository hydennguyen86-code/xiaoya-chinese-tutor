{
  "name": "xiaoya-chinese-tutor",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,web -c magenta,cyan \"node server/index.mjs\" \"vite\"",
    "build": "tsc --noEmit && vite build && node scripts/check-dist.mjs",
    "start": "node server/index.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test server/*.test.mjs src/lib/*.test.ts && tsx --tsconfig tsconfig.test.json --test src/components/*.test.tsx",
    "eval:corrections": "node eval/corrections.mjs",
    "eval:tones": "node eval/tones.mjs",
    "setup:stt": "bash scripts/setup-stt.sh",
    "setup:whisper": "bash scripts/setup-whisper.sh",
    "format": "node scripts/format.mjs",
    "format:check": "node scripts/format.mjs --check",
    "check:assets": "node scripts/check-public-assets.mjs",
    "review:lesson": "node scripts/review-lesson.mjs",
    "setup:whisper:windows": "powershell -NoProfile -File scripts/setup-whisper.ps1",
    "test:edge:live": "node scripts/test-edge-live.mjs",
    "corpus:import": "node scripts/import-common-voice.mjs",
    "setup:tone": "bash tone/setup.sh",
    "tone:service": ".venv-tone/bin/python -I tone/tone_service.py",
    "tone:dataset": "node eval/tone-train/make-dataset.mjs --out data/tone-train/say --say && node eval/tone-train/make-dataset.mjs --out data/tone-train/edge --edge",
    "tone:train": ".venv-tone/bin/python -I tone/train.py --manifests data/tone-train/say/manifest.jsonl data/tone-train/edge/manifest.jsonl --out tone/weights",
    "eval:azure": "node eval/azure-pronunciation.mjs",
    "eval:stt": "node eval/stt-compare.mjs"
  },
  "dependencies": {
    "@met4citizen/talkinghead": "^1.7.0",
    "@myned-ai/gsplat-flame-avatar-renderer": "^1.4.0",
    "express": "^5.3.0",
    "hanzi-writer": "^3.7.3",
    "hanzi-writer-data": "^2.0.1",
    "jszip": "^3.10.2",
    "msedge-tts": "^2.1.0",
    "pinyin-pro": "^3.29.5",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "selfsigned": "^5.5.0",
    "three": "^0.186.1",
    "ts-fsrs": "^6.0.0"
  },
  "optionalDependencies": {
    "sherpa-onnx-node": "2.0.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
